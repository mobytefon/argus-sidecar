# Copy to .env once and edit it; do not overwrite an existing deployment's .env.
# Standalone stack only: MOBI-WAF runs the sidecar from its own
# docker-compose.argus.yml and .env.

# Host directory with the five model files, mounted read-only at /model.
# ./model is the bundle in this checkout; for a deployment use a directory of
# its own (copy new model files over it to hot-swap the model).
ARGUS_MODEL_DIR_HOST=./model

# 10000:10000 (image user) or 0:0 under rootless Docker (the host user).
ARGUS_USER=10000:10000

# Socket volume shared with Caddy, which mounts it at /run/argus. Custom
# socket paths must stay in /run/argus.
ARGUS_SOCKET_VOLUME=argus-run
ARGUS_SOCKET=/run/argus/argus.sock
ARGUS_SOCKET_MODE=0o660

ARGUS_THRESHOLD=fpr0.1%
ARGUS_WORKERS=4
# Keep the Caddy action's ARGUS_MAX_INFLIGHT <= ARGUS_MAX_CONCURRENT_RPCS.
ARGUS_MAX_CONCURRENT_RPCS=16
# Seconds between model-file checks; 0 disables polling (SIGHUP still reloads).
ARGUS_RELOAD_INTERVAL_S=5
ARGUS_MIN_REMAINING_MS=5
ORT_INTRA_THREADS=1
ARGUS_LOG_LEVEL=INFO
# One log line per ML check: all, attack (attack verdicts only) or off.
ARGUS_LOG_REQUESTS=all
ARGUS_CPUS=2
ARGUS_MEM_LIMIT=512m
